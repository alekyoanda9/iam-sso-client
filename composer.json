{
    "name": "sd1/iam-sso-client",
    "description": "SDK Laravel untuk login SSO ke IAM (OAuth2 authorization code + JWT RS256) dan otorisasi menu/aksi terpusat. Kompatibel PHP 7.1+ / Laravel 5.8+.",
    "type": "library",
    "license": "proprietary",
    "require": {
        "php": ">=7.1.3",
        "ext-json": "*",
        "ext-openssl": "*",
        "guzzlehttp/guzzle": "^6.3|^7.0",
        "illuminate/support": "^5.8|^6.0|^7.0|^8.0|^9.0|^10.0|^11.0|^12.0|^13.0",
        "illuminate/http": "^5.8|^6.0|^7.0|^8.0|^9.0|^10.0|^11.0|^12.0|^13.0",
        "illuminate/console": "^5.8|^6.0|^7.0|^8.0|^9.0|^10.0|^11.0|^12.0|^13.0"
    },
    "require-dev": {
        "orchestra/testbench": "^9.0|^10.0",
        "phpunit/phpunit": "^10.5|^11.0",
        "squizlabs/php_codesniffer": "^3.10",
        "phpcompatibility/php-compatibility": "^9.3",
        "dealerdirect/phpcodesniffer-composer-installer": "^1.0"
    },
    "autoload": {
        "psr-4": {
            "Sd1\\IamSso\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Sd1\\IamSso\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Sd1\\IamSso\\SsoServiceProvider"
            ],
            "aliases": {
                "Sso": "Sd1\\IamSso\\Facades\\Sso"
            }
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
